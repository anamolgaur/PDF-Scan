<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Live camera for scanning. Asked for the first time you open the scanner. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
        Used only for the optional Google Drive link. The app makes no network connection while
        "Allow internet access" is off in Settings (the default), and every connection goes through
        DriveClient, which checks that setting first.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Optional phone-wide search. Asked only when you switch on "Make documents on this phone
        searchable": Android 11+ shows its "All files access" screen; Android 10 asks for storage.
        Files are read, never changed or uploaded. A file is only deleted when you choose Delete
        (a copy stays in the app's recycle bin for 30 days).
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 10 only: needed to delete a file when you choose Delete. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Background indexing with a progress notification until it is done. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Background music with a media notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".PdfScanApp"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="PDF Scan"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.PdfScan">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ViewerActivity"
            android:exported="false" />

        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PdfScan.Camera" />

        <activity
            android:name=".PageEditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PagePreviewActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <service
            android:name=".FileIndexService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name=".PhoneFileProvider"
            android:authorities="com.anamol.pdfscan.phonefiles"
            android:exported="false"
            android:grantUriPermissions="true" />

        <activity
            android:name=".TrashActivity"
            android:exported="false" />

        <activity
            android:name=".LanguagesActivity"
            android:exported="false" />

        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true" />

        <!-- "Share to PDF Scan" / "Open with PDF Scan" from other apps: PDFs and pictures -->
        <activity
            android:name=".ShareInActivity"
            android:exported="true"
            android:label="Add to PDF Scan"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Reads PDFs and documents inside the app; also "Open with PDF Scan" for PDFs -->
        <activity
            android:name=".DocReaderActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="PDF Scan">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <provider
            android:name=".ShareProvider"
            android:authorities="com.anamol.pdfscan.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".PhoneWatchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
